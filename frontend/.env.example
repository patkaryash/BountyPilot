# Frontend env. Copy to .env for local overrides. No secrets here —
# VITE_* values are bundled into browser JS, so NEVER put private keys here.
#
# Localhost defaults (active). Must match deployments/localhost.json
# after `npm run deploy:local`.
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_EXPECTED_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
#
# Sepolia (chain ID 11155111): after deploying, point the frontend at the
# Sepolia contract WITHOUT touching localhost defaults above — copy these
# lines into .env and uncomment:
# VITE_CONTRACT_ADDRESS=0xPASTE_SEPOLIA_DEPLOYED_ADDRESS_HERE
# VITE_EXPECTED_CHAIN_ID=11155111
